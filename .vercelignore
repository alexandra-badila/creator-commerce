# The CLI does not read .gitignore. Without this, `vercel deploy` uploads .env,
# Next loads it at build and runtime, and APP_URL=http://localhost:3000 pins
# production to localhost (lib/server/app-url.ts).
.env*
!.env.example

# Local build output and caches. Vercel builds from source, and these hold
# webpack/turbopack cache packs over the CLI's 100 MB per-file upload limit.
/.next/
/.next-e2e/
/node_modules/
/test-results/
/playwright-report/
/blob-report/
/coverage/
*.tsbuildinfo
